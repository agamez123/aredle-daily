# Copy to .env.local (gitignored via the *.local pattern) and fill in real
# values. Nothing here is required to run the app locally — analytics simply
# no-ops without a website ID configured.

# Umami website ID: cloud.umami.is -> your website -> Edit -> Tracking code.
VITE_UMAMI_WEBSITE_ID=

# Only for a self-hosted Umami instance instead of Umami Cloud.
# VITE_UMAMI_SRC=https://your-umami-instance.example.com/script.js
