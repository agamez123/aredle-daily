# Copy to .env.local (already gitignored via the *.local pattern) and fill
# in real values. Nothing here is required to run the app locally — analytics
# just no-ops without a website ID configured.

# Umami Cloud website ID (Websites -> your site -> Settings -> Tracking code
# on cloud.umami.is). Leave unset in local dev.
VITE_UMAMI_WEBSITE_ID=

# Only needed for a self-hosted Umami instance instead of Umami Cloud.
# VITE_UMAMI_SRC=https://your-umami-instance.example.com/script.js
